{
  "manifest_version": 3,
  "name": "Utab",
  "version": "1.1",
  "permissions": [
    "tabs",
    "scripting",
    "favicon",
    "storage",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Offset Overlay"
  },
  "options_ui": {
    "page": "option_page/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "chrome_url_overrides": {
    "newtab": "redirect.html"
  },
  "commands": {
    "utab-jump-mode-plus": {
      "suggested_key": {
        "mac": "Ctrl+U",
        "windows": "Alt+U"
      },
      "description": "Enter jump mode minus"
    },
    "utab-jump-mode-minus": {
      "suggested_key": {
        "mac": "Ctrl+I",
        "windows": "Alt+I"
      },
      "description": "Enter jump mode plus"
    },
    "utab-jump-back": {
      "suggested_key": {
        "mac": "Ctrl+B",
        "windows": "Alt+B"
      },
      "description": "Enter jump mode plus"
    },
    "utab-search": {
      "suggested_key": {
        "mac": "Ctrl+Shift+L",
        "windows": "Alt+Shift+L"
      },
      "description": "Enter search mode"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
