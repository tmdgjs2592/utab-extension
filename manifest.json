{
  "manifest_version": 3,
  "name": "Utab",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "scripting",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Offset Overlay"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "chrome_url_overrides": {
    "newtab": "redirect.html"
  },
  "commands": {
    "utab-jump-mode-plus": {
      "suggested_key": {
        "mac": "Ctrl+U"
      },
      "description": "Enter jump mode minus"
    },
    "utab-jump-mode-minus": {
      "suggested_key": {
        "mac": "Ctrl+I"
      },
      "description": "Enter jump mode plus"
    }
  }
}
